// config
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  DOCTOR
}

enum Lang {
  EN
  AR
}

enum LoginType {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NORMAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum Levels {
  FIRST_SECONDARY
  SECOND_SECONDARY
  THIRD_SECONDARY
}

enum StudyMode {
  ONLINE
  CENTER
}

enum CouponType {
  FULL_ACCESS
  PERCENT
  FIXED
}

// Models
model Admin {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  email                  String    @unique
  role                   Role      @default(ADMIN)
  password               String
  phone                  String?   @unique
  isSuperAdmin           Boolean   @default(false)
  isVerified             Boolean   @default(false)
  isBlocked              Boolean   @default(false)
  isDeleted              Boolean   @default(false)
  passwordChangedAt      DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  verificationToken      String?
  verificationTokenExp   DateTime?
  token                  String?
  tokenExpDate           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([firstName, lastName])
}

model User {
  id                        String             @id @default(uuid())
  lang                      Lang               @default(AR)
  loginType                 LoginType          @default(EMAIL)
  fullName                  String
  phone                     String             @unique
  parentPhone               String
  level                     Levels
  studentCode               String             @unique
  groupeId                  String?
  studyMode                 StudyMode
  budget                    Float              @default(0)
  role                      Role               @default(USER)
  governmentId              String
  // Password
  password                  String
  passwordChangedAt         DateTime?
  passwordResetCode         String?
  passwordResetCodeExp      DateTime?
  passwordResetCodeVerified Boolean?
  // Verification
  verificationCode          String?
  verificationCodeExp       DateTime?
  verificationCodeVerified  Boolean?
  passwordVerificationToken String?
  passwordResetExpiresAt    DateTime?
  isVerified                Boolean            @default(false)
  // Active
  deactivatedAt             DateTime?
  isActive                  Boolean            @default(true)
  isBlocked                 Boolean            @default(false)
  // Auth
  token                     String?
  tokenExpDate              DateTime?
  notificationToken         String?            @default("")
  // Timestamps
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  government                Government         @relation(fields: [governmentId], references: [id])
  groupe                    Groupe?            @relation(fields: [groupeId], references: [id])
  enrollments               Enrollment[]
  payments                  Payment[]
  couponRedemptions         CouponRedemption[]

  @@index(fullName)
}

model Government {
  id        String   @id @default(uuid())
  name      String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index(name)
}

model Groupe {
  id        String   @id @default(uuid())
  name      String
  day       String
  time      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Course {
  id                 String             @id @default(uuid())
  title              String
  description        String
  slug               String             @unique
  price              Decimal            @default(0) @db.Decimal(10, 2)
  image              String
  level              Levels
  isFree             Boolean            @default(false)
  isPublished        Boolean            @default(true)
  isDeleted          Boolean            @default(false)
  discountPercent    Float              @default(0)
  hasDiscount        Boolean            @default(false)
  priceAfterDiscount Decimal            @default(0) @db.Decimal(10, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  //Relations
  sections           Section[]
  enrollments        Enrollment[]
  coupons            Coupon[]
  payments           Payment[]
  couponRedemptions  CouponRedemption[]
}

model Section {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  isDeleted   Boolean  @default(false)
  isFree      Boolean  @default(false)
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String

  @@index([courseId])
}

model Lesson {
  id           String      @id @default(uuid())
  title        String
  description  String?
  bunnyVideoId String      @unique
  videoStatus  VideoStatus @default(UPLOADING)
  attachments  String[]    @default([])
  isPreview    Boolean     @default(false)
  duration     Int?
  order        Int
  isDeleted    Boolean     @default(false)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  progress LessonProgress[]

  @@index([sectionId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model Payment {
  id String @id @default(uuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)

  orderCode    String  @unique
  amount       Decimal @db.Decimal(10, 2)
  billedAmount Decimal @db.Decimal(10, 2)

  cardNum  String?
  cardType String?
  currency String  @default("EGP")

  status       PaymentStatus @default(PENDING)
  clientSecret String?

  enrollment Enrollment?
  redemption CouponRedemption?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([couponId])
}

model Enrollment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  progress    Float     @default(0)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model Coupon {
  id   String     @id @default(uuid())
  code String     @unique
  type CouponType

  value Decimal? @db.Decimal(10, 2)

  maxUses      Int?
  usedCount    Int  @default(0)
  perUserLimit Int  @default(1)

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  redemptions CouponRedemption[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model CouponRedemption {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  originalPrice  Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  finalPrice     Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([userId])
  @@index([courseId])
}
